# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/

# AEC raw data (large CSVs – don't commit to Git)
data/raw/
!data/raw/vic/
!data/raw/vic/**
data/processed/

# Database (generated – don't commit)
# aec_elections.db is committed (state election 2CP data for calibration)
data/elections.db

# Export JSONs (generated – can be committed for small elections,
# but are large for national booth-level data)
data/exports/

# Logs
*.log
pipeline.log

# Environment / secrets
.env
.env.*

# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp

# Node / Vite
node_modules/
webapp/node_modules/
frontend/node_modules/
webapp/dist/
frontend/.next/
.next/
*.local

# betting_odds.json is tracked so GitHub Actions can commit updated odds automatically

# pytest cache files (generated)
pytest-cache-files-*/
